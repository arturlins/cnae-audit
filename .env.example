# Copie para .env e preencha. Nunca commite o .env.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=sua-chave-aqui
# Modelo Gemini com suporte a tool calling (padrão do projeto: gemini-3.6-flash, usado nos testes)
GEMINI_MODEL_ID=gemini-3.6-flash
# Timeout (s) de cada requisição ao Gemini
GEMINI_TIMEOUT_S=30

# AgentOS
AGENTOS_PORT=7777
AGENTOS_DB=tmp/agentos.db
# Opcional: se definida, o AgentOS exige "Authorization: Bearer <chave>" e o app web a envia
OS_SECURITY_KEY=

# Ferramentas
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v2/cnae
IBGE_TIMEOUT_S=5
REGRAS_PATH=data/regras_cnae.json

# App web (cliente do AgentOS)
AGENTOS_URL=http://localhost:7777
AGENTOS_TIMEOUT_S=120
